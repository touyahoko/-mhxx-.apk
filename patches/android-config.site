# Android クロスビルド向け CONFIG_SITE 上書きファイル
#
# NDK の sysroot ヘッダーは全 API レベル共通のため、高い API でしか
# 使えない関数も宣言されている。configure はヘッダーを見て「有り」と
# 判定するが、低い minapi でコンパイルすると実際には使えず失敗する。
#
# ── grp モジュール ──────────────────────────────────────────────────
# getgrgid は宣言されているが getgrent/setgrent/endgrent が Android に無い。
# Modules/grpmodule.c のビルドをスキップして解決。
# 上流バグ: https://github.com/python/cpython/issues/114875
ac_cv_func_getgrgid=no

# ── pwritev / preadv について ────────────────────────────────────────
# これらは Android API 24+ のみ利用可能で、minapi=23 では宣言なしエラーになる。
# ただし ac_cv_func_pwritev=no を設定すると別の未定義シンボル
# (search_linux_map_for_section) が発生する (CPython issue #139275)。
# そのため config.site ではなく、GitHub Actions のシムスクリプトで
# remote_debugging.c / remote_debug.h の先頭にマクロスタブを挿入して対応する。
