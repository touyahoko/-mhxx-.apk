# autoconf の CONFIG_SITE 機構を使い、Android向けクロスビルド時に
# getgrgid が「無い」と判定させることで、CPythonの grp モジュール
# (Modules/grpmodule.c) のビルド自体をスキップさせるためのファイル。
#
# 背景: grp モジュールは configure スクリプト上 getgrgid の有無だけを
# 判定基準にしているが、Androidには getgrgid はあっても getgrent /
# setgrent / endgrent が無いため、grpmodule.c のコンパイルが
# 「暗黙の関数宣言はエラー」という最近のNDKの既定挙動と衝突して失敗する。
# (上流バグ: https://github.com/python/cpython/issues/114875)
#
# mhxx_rng アプリ自体は grp モジュールを一切使用しないため、
# ビルドから除外しても動作に影響しない。

ac_cv_func_getgrgid=no
