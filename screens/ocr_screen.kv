#:kivy 2.3.1

<OcrScreen>:
    do_scroll_x: False
    BoxLayout:
        id: content
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        padding: '10dp'
        spacing: '6dp'

        SectionLabel:
            text: '鑑定結果読み取り (OCR)'

        HintLabel:
            text: '現在選択中の「お守り種類」(上部) に対して読み取ります。写真を撮る/選ぶか、下のテキスト欄に直接入力・貼り付けしてください。Switch本体との通信は行いません。'

        BoxLayout:
            size_hint_y: None
            height: '46dp'
            spacing: '6dp'
            PrimaryButton:
                id: camera_btn
                text: '写真を撮る'
                on_release: root._take_photo()
            PrimaryButton:
                text: 'ギャラリーから選択'
                on_release: root._pick_gallery()

        Label:
            id: status_label
            text: ''
            font_size: '12sp'
            size_hint_y: None
            height: self.texture_size[1] + 8 if self.text else 0
            halign: 'left'
            valign: 'top'
            text_size: self.width, None
            color: 0.55, 0.78, 1, 1

        FieldLabel:
            text: '認識テキスト'
            width: 200

        TextInput:
            id: text_input
            hint_text: '例: 会心撃+7 剥ぎ取り名人+3 スロット2'
            multiline: True
            font_size: '14sp'
            size_hint_y: None
            height: '110dp'

        BoxLayout:
            size_hint_y: None
            height: '46dp'
            spacing: '6dp'
            PrimaryButton:
                text: 'この内容を解析'
                on_release: root._analyze()
            Button:
                text: 'クリア'
                on_release: root._clear()

        Label:
            id: result_label
            text: ''
            font_size: '13sp'
            size_hint_y: None
            height: self.texture_size[1] + 16 if self.text else 0
            halign: 'left'
            valign: 'top'
            text_size: self.width, None
            color: 0.9, 0.9, 0.93, 1

        PrimaryButton:
            id: apply_btn
            text: '検索タブへ反映'
            disabled: True
            on_release: root._apply_to_search()
