#:kivy 2.3.1
# オートタブ ─ USB OTG 接続 / Arduino 自動ループ
# 接続: スマホ USB-C → OTG → ANYOYO ハブ → Arduino Leonardo

<AutoScreen>:
    orientation: 'vertical'
    spacing: '4dp'
    padding: ['6dp', '4dp', '6dp', '4dp']

    # ── 接続構成ガイド ──────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: '38dp'
        spacing: '4dp'
        canvas.before:
            Color:
                rgba: 0.10, 0.13, 0.18, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [5]
        Label:
            text: 'スマホ USB-C → OTG → ANYOYO ハブ → Arduino Leonardo (+ Switch HID)'
            font_size: '10sp'
            color: 0.55, 0.75, 1.0, 1
            halign: 'center'
            valign: 'middle'
            text_size: self.size

    # ── USB デバイス確認 ──────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: '32dp'
        spacing: '6dp'

        Label:
            text: '接続済み USB:'
            size_hint_x: None
            width: '82dp'
            font_size: '11sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        ScrollView:
            do_scroll_y: False
            do_scroll_x: True
            size_hint_x: 1
            Label:
                text: root.usb_dev_labels[0] if root.usb_dev_labels else '──'
                font_size: '10sp'
                color: 0.7, 0.9, 0.7, 1
                size_hint_x: None
                width: max(self.texture_size[0], 200)
                valign: 'middle'
                text_size: None, self.height

        Button:
            text: '再検索'
            size_hint_x: None
            width: '58dp'
            font_size: '11sp'
            background_color: 0.2, 0.35, 0.55, 1
            on_release: root._refresh_usb_devices()

    # ── 接続ボタン ────────────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: '44dp'
        spacing: '8dp'

        Button:
            text: root.conn_btn_text
            size_hint_x: None
            width: '88dp'
            font_size: '14sp'
            bold: True
            background_color:
                (0.65, 0.15, 0.15, 1) if root.is_connected else (0.15, 0.50, 0.20, 1)
            on_release: root.toggle_connect()

        Label:
            text: root.status_text
            font_size: '11sp'
            color: (0.20, 0.90, 0.45, 1) if root.is_connected else (0.90, 0.70, 0.20, 1)
            halign: 'left'
            valign: 'middle'
            text_size: self.size

    # ── 区切り線 ──────────────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: '1dp'
        canvas.before:
            Color:
                rgba: 0.28, 0.28, 0.28, 1
            Rectangle:
                pos: self.pos
                size: self.size

    # ── 目標お守り表示 ──────────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: '30dp'
        spacing: '6dp'

        Label:
            text: '目標:'
            size_hint_x: None
            width: '40dp'
            font_size: '12sp'
            bold: True
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            text: root.target_text
            font_size: '11sp'
            color: 0.30, 0.82, 1.0, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Button:
            text: '更新'
            size_hint_x: None
            width: '44dp'
            font_size: '10sp'
            background_color: 0.25, 0.35, 0.50, 1
            on_release: root._refresh_target_text()

    # ── 目標直接入力 (コンパクト) ──────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: '30dp'
        spacing: '4dp'

        Label:
            text: 'S1 idx'
            size_hint_x: None
            width: '40dp'
            font_size: '10sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        TextInput:
            id: inp_s1_idx
            hint_text: '0'
            input_filter: 'int'
            multiline: False
            font_size: '12sp'
            size_hint_x: 0.13

        Label:
            text: 'Pt≥'
            size_hint_x: None
            width: '26dp'
            font_size: '10sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        TextInput:
            id: inp_s1_pts
            hint_text: '1'
            input_filter: 'int'
            multiline: False
            font_size: '12sp'
            size_hint_x: 0.13

        Label:
            text: 'S2 idx'
            size_hint_x: None
            width: '40dp'
            font_size: '10sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        TextInput:
            id: inp_s2_idx
            hint_text: '(任意)'
            input_filter: 'int'
            multiline: False
            font_size: '12sp'
            size_hint_x: 0.13

        Label:
            text: 'Pt≥'
            size_hint_x: None
            width: '26dp'
            font_size: '10sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        TextInput:
            id: inp_s2_pts
            hint_text: '0'
            input_filter: 'int'
            multiline: False
            font_size: '12sp'
            size_hint_x: 0.13

        Label:
            text: 'Slot'
            size_hint_x: None
            width: '28dp'
            font_size: '10sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        TextInput:
            id: inp_slot
            hint_text: '-1'
            input_filter: 'int'
            multiline: False
            font_size: '12sp'
            size_hint_x: 0.13

        Button:
            text: '設定'
            size_hint_x: None
            width: '44dp'
            font_size: '11sp'
            background_color: 0.28, 0.48, 0.68, 1
            on_release: root.apply_target_from_fields()

    # ── 区切り線 ──────────────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: '1dp'
        canvas.before:
            Color:
                rgba: 0.28, 0.28, 0.28, 1
            Rectangle:
                pos: self.pos
                size: self.size

    # ── ループ制御 ────────────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: '52dp'
        padding: ['0dp', '6dp', '0dp', '6dp']

        Button:
            text: root.loop_btn_text
            font_size: '15sp'
            bold: True
            background_color: (0.65, 0.15, 0.15, 1) if root.loop_running else (0.35, 0.35, 0.35, 1) if not root.is_connected else (0.15, 0.55, 0.22, 1)
            disabled: not root.is_connected and not root.loop_running
            on_release: root.toggle_loop()

    # ── ログヘッダー ──────────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: '24dp'
        spacing: '6dp'

        Label:
            text: 'ログ'
            size_hint_x: None
            width: '32dp'
            font_size: '11sp'
            bold: True
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            text: '← 映像タブでカメラを先に開始してください'
            font_size: '10sp'
            color: 0.50, 0.50, 0.50, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            size_hint_x: 1

        Button:
            text: 'クリア'
            size_hint_x: None
            width: '52dp'
            font_size: '10sp'
            background_color: 0.28, 0.28, 0.28, 1
            on_release: root.clear_log()

    # ── ログ本文 ─────────────────────────────────────────────
    ScrollView:
        size_hint_y: 1
        do_scroll_x: False
        scroll_y: 0

        Label:
            text: '\n'.join(root.log_lines) if root.log_lines else '（ここにログが表示されます）'
            font_size: '11sp'
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
            halign: 'left'
            valign: 'top'
            color: 0.85, 0.85, 0.85, 1
            padding: ['4dp', '2dp']
