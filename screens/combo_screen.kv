#:kivy 2.3.1
#:import IntInput screens.common.IntInput

<ComboScreen>:
    do_scroll_x: False
    BoxLayout:
        id: content
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        padding: '10dp'
        spacing: '6dp'

        SectionLabel:
            text: '調合スナイプ (累計作成数からフレーム特定)'

        HintLabel:
            text: '調合画面で確認した「累計作成数」を半角スペース区切りで入力してください。(先頭3件と末尾の99は自動で無視されます)  例: 0 3 6 9 11 13 16 19 21'

        TextInput:
            id: sequence_input
            hint_text: '0 3 6 9 11 13 16 19 ...'
            multiline: True
            font_size: '14sp'
            size_hint_y: None
            height: '80dp'
            on_text: root._validate(self.text)

        Label:
            id: validation_label
            text: ''
            font_size: '12sp'
            size_hint_y: None
            height: self.texture_size[1] + 8
            halign: 'left'
            valign: 'top'
            text_size: self.width, None

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: '開始フレーム'
            IntInput:
                id: start_input
                text: '0'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: 'ステップ数'
            IntInput:
                id: step_input
                text: '10000000'

        BoxLayout:
            size_hint_y: None
            height: '46dp'
            spacing: '6dp'
            PrimaryButton:
                id: search_btn
                text: '検索'
                on_release: root._on_search()
            DangerButton:
                id: stop_btn
                text: '停止'
                disabled: True
                on_release: root._on_stop()
            Button:
                text: 'クリア'
                on_release: root._on_clear()

        ProgressBar:
            id: progress
            size_hint_y: None
            height: '8dp'
            opacity: 0
            max: 100

        SectionLabel:
            id: result_label
            text: '検索結果: 0 件'

        BoxLayout:
            id: results_box
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: '2dp'
