#:kivy 2.3.1
#:import IntInput screens.common.IntInput

<SearchScreen>:
    do_scroll_x: False
    BoxLayout:
        id: content
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        padding: '10dp'
        spacing: '6dp'

        SectionLabel:
            text: '検索条件'

        FieldLabel:
            text: 'スキル1'
            size_hint_x: 1
            width: 0
        Spinner:
            id: skill1_spinner
            size_hint_y: None
            height: '42dp'
            font_size: '14sp'
            on_text: root.on_skill1_selected(self.text)
        BoxLayout:
            size_hint_y: None
            height: '38dp'
            spacing: '8dp'
            HintLabel:
                id: skill1_hint
                text: 'Pt:'
                size_hint_x: 0.5
                height: '38dp'
            IntInput:
                id: skill1_pt
                size_hint_x: 0.5
                text: '1'

        BoxLayout:
            size_hint_y: None
            height: '34dp'
            spacing: '8dp'
            CheckBox:
                id: skill2_check
                size_hint_x: None
                width: '34dp'
                on_active: root.on_skill1_selected(root.ids.skill1_spinner.text)
            FieldLabel:
                text: 'スキル2を指定する'
                width: '200dp'
        Spinner:
            id: skill2_spinner
            size_hint_y: None
            height: '42dp'
            font_size: '14sp'
            disabled: not skill2_check.active
            on_text: root.on_skill2_selected(self.text)
        BoxLayout:
            size_hint_y: None
            height: '38dp'
            spacing: '8dp'
            HintLabel:
                id: skill2_hint
                text: 'Pt:'
                size_hint_x: 0.5
                height: '38dp'
            IntInput:
                id: skill2_pt
                size_hint_x: 0.5
                text: '1'
                disabled: not skill2_check.active

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: 'スロット'
            Spinner:
                id: slot_spinner
                text: '0'
                values: ['0', '1', '2', '3']
                font_size: '14sp'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: 'モード'
            ToggleButton:
                id: mode_exact
                text: '完全一致'
                group: 'search_mode'
                state: 'down'
                font_size: '13sp'
            ToggleButton:
                id: mode_greater
                text: '以上'
                group: 'search_mode'
                font_size: '13sp'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: '入手方法'
            Spinner:
                id: origin_spinner
                text: 'マカ'
                values: ['マカ', '炭鉱']
                font_size: '14sp'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: '開始フレーム'
            IntInput:
                id: start_input
                text: '0'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: 'ステップ数'
            IntInput:
                id: step_input
                text: '10000000'

        HintLabel:
            text: 'ステップ数が大きいほど時間がかかります (端末により数十秒〜)。バックグラウンドで実行するので他のタブに切り替えても継続できます。「停止」は即座には止まらず、端末の負荷次第で数秒かかることがあります。'

        BoxLayout:
            size_hint_y: None
            height: '46dp'
            spacing: '6dp'
            PrimaryButton:
                id: search_btn
                text: '検索'
                on_release: root._on_search()
            DangerButton:
                id: stop_btn
                text: '停止'
                disabled: True
                on_release: root._on_stop()
            Button:
                text: 'クリア'
                on_release: root._on_clear()

        ProgressBar:
            id: progress
            size_hint_y: None
            height: '8dp'
            opacity: 0
            max: 100

        SectionLabel:
            id: result_label
            text: '検索結果: 0 件'

        BoxLayout:
            id: results_box
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: '2dp'
