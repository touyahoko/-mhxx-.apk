#:kivy 2.3.1
#:import IntInput screens.common.IntInput

<AroundScreen>:
    do_scroll_x: False
    BoxLayout:
        id: content
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        padding: '10dp'
        spacing: '6dp'

        SectionLabel:
            text: '周辺確認 (指定フレーム前後のお守り)'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: 'フレーム'
            IntInput:
                id: frame_input
                text: '0'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: '± 件数'
            IntInput:
                id: count_input
                text: '20'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '8dp'
            FieldLabel:
                text: '入手方法'
            Spinner:
                id: origin_spinner
                text: 'マカ'
                values: ['マカ', '炭鉱']
                font_size: '14sp'

        PrimaryButton:
            text: '表示'
            on_release: root._show()

        SectionLabel:
            id: result_label
            text: ''

        BoxLayout:
            id: results_box
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: '2dp'
